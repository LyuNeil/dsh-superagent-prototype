# Copy to docker/.env and fill in. `docker-compose` reads it next to the compose file.
#
# The git host the agent works on: `gitlab` or `github`. It decides which Source plugin is enabled.
# On `gitlab`, configure the GitLab Source in the panel with the host, project and this token file:
#   DSH_GIT_HOST=gitlab
#   the token file defaults to /data/secrets/gitlab-token (see docker/README.md)
DSH_GIT_HOST=gitlab

# The model provider. Every Session (the main Session and each Executor) uses this
# provider unless Settings -> Eval / Execution names another model.
DSH_LLM_PROVIDER=new-api
DSH_LLM_MODEL=deepseek-v4.1-flash
# An OpenAI-compatible endpoint reachable from the container. With host networking,
# 127.0.0.1 is the Docker host's own loopback.
DSH_LLM_BASE_URL=http://127.0.0.1:38317/v1
# The name of the environment variable that holds the key, and the key itself.
# Both must be set; the key never appears in the rendered profile file.
DSH_LLM_API_KEY_ENV=DSH_LLM_API_KEY
DSH_LLM_API_KEY=

# The Feishu bot the agent speaks as. `lark-cli` reads its app secret from this variable when
# docker/README.md signs the bot in; setup checks the CLI's strict mode and bot identity later.
# LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
# LARK_APP_SECRET=

# The panel's port on the Docker host's loopback. dsh-superagent's management API only
# answers Host headers of 127.0.0.1:<port> or localhost:<port>.
DSH_SUPERAGENT_PORT=3082

# Build inputs. The base image carries the toolchain and is rebuilt only when that
# changes (see docker/README.md); the application image builds FROM it.
# BASE_IMAGE=dsh-superagent-base:bookworm
# DSH_VERSION=0.2.1-rc.3
# PNPM_VERSION=11.7.0
# NPM_REGISTRY=https://registry.npmmirror.com

# Limits for one container. Workers run builds and dev servers inside it.
# MEM_LIMIT=8g
# CPU_LIMIT=4

# Optional: a clone of the target repository on the host, mounted at /repo for the
# prepare command. Leave unset to let each Ticket run its prepare command in an empty
# directory, or set a prepare command that clones.
# REPO_CLONE=/home/me/src/scene_mining
